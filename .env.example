# ==============================================================================
# Multi-AI Configuration File (.env)
# ==============================================================================
# Điền API Key của các nhà cung cấp bạn muốn sử dụng.
# Không cần điền tất cả; hệ thống sẽ tự nhận diện những provider đã có key.

# --- OpenAI ---
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# --- Anthropic Claude ---
# Lấy key tại: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Groq (OpenAI-compatible siêu tốc & Free Tier) ---
# Lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- General Settings ---
DEFAULT_PROVIDER=groq
APP_TIMEOUT_SECONDS=30
